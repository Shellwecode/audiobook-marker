      "accent":   { "value": "#c47333",               "css": "--accent",  "figma": "light/accent" },
      "red":      { "value": "#c0392b",               "css": "--red",     "figma": "light/red" },
      "green":    { "value": "#1e8449",               "css": "--green",   "figma": "light/green" },
