  },

  "shadows": {
    "dark": {
      "cover":   { "value": "0 24px 60px rgba(0,0,0,0.6), 0 0 0 1px var(--border)", "css": "--cover-shadow", "figma": "dark/cover-shadow" },
      "playBtn": { "value": "0 4px 20px rgba(240,237,232,0.15)",                     "css": "--play-shadow",  "figma": "dark/play-shadow" }
    },
    "light": {
      "cover":   { "value": "0 16px 48px rgba(0,0,0,0.1), 0 0 0 1px var(--border)", "css": "--cover-shadow", "figma": "light/cover-shadow" },
      "playBtn": { "value": "0 4px 20px rgba(28,26,23,0.12)",                        "css": "--play-shadow",  "figma": "light/play-shadow" }
    }
  },

  "typography": {
    "heading": {
      "fontFamily": "'Playfair Display', serif",
      "figmaFont": "Playfair Display",
      "styles": {
        "title":     { "size": "20px", "weight": 600, "letterSpacing": "-0.01em", "figma": "heading/title" },
        "modal":     { "size": "18px", "weight": 400, "figma": "heading/modal" },
        "logo":      { "size": "14px", "weight": 400, "letterSpacing": "0.15em", "textTransform": "uppercase", "figma": "heading/logo" },
        "cardTitle": { "size": "12px", "weight": 600, "lineHeight": 1.35, "figma": "heading/card-title" },
        "coverLetter": { "size": "34px", "weight": 400, "fontStyle": "italic", "figma": "heading/cover-letter" }
      }
    },
    "body": {
      "fontFamily": "'DM Sans', sans-serif",
      "figmaFont": "DM Sans",
      "styles": {
        "base":  { "size": "13px", "weight": 400, "lineHeight": 1.55, "figma": "body/base" },
        "small": { "size": "12px", "weight": 400, "letterSpacing": "0.04em", "figma": "body/small" },
        "tiny":  { "size": "11px", "weight": 400, "letterSpacing": "0.04em", "figma": "body/tiny" },
        "micro": { "size": "10px", "weight": 400, "letterSpacing": "0.08em", "textTransform": "uppercase", "figma": "body/micro" },
        "nano":  { "size": "9px",  "weight": 500, "letterSpacing": "0.07em", "textTransform": "uppercase", "figma": "body/nano" }
      }
    }
  },

  "spacing": {
    "topbarHeight": "52px",
    "topbarPadding": "24px",
    "coverSize": "200px",
    "playerWidth": "320px",
    "controlGap": "24px",
    "drawerPadding": "20px",
    "modalPadding": "28px",
    "modalWidth": "380px",
    "libraryModalWidth": "540px"
  },

  "radii": {
    "small": "6px",
    "medium": "8px",
    "large": "10px",
    "pill": "20px",
    "drawer": "18px",
    "modal": "14px",
    "round": "50%"
  },

  "animation": {
    "themeTransition": "0.25s ease",
    "drawerCurve": "cubic-bezier(0.32, 0.72, 0, 1)",
    "drawerDuration": "0.4s",
    "spinDuration": "12s",
    "breatheDuration": "2.8s"
  }
}
